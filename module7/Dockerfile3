


# Use official Python image
FROM python:3.12-slim

# Set working directory
WORKDIR /app

COPY req.txt .
RUN pip install --no-cache-dir -r req.txt

# Copy your code
COPY shamsa_module7_3.py .

# Run the program
CMD ["uvicorn", "shamsa_module7_3:app", "--host", "127.0.0.1", "--port", "8000"]

EXPOSE 8000

